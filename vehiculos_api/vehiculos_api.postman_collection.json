        { "name": "Create fleet log (Public) - POST /api/fleet-logs/ (save fleetLogId)", "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "let jsonData = {};", "try { jsonData = pm.response.json(); } catch (e) {}", "if (jsonData._id) pm.collectionVariables.set('fleetLogId', jsonData._id);", "pm.test('Fleet log creado', function () { pm.expect(jsonData._id).to.be.ok; });" ] } } ], "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/api/fleet-logs/", "host": ["{{baseUrl}}"], "path": ["api", "fleet-logs", ""] }, "body": { "mode": "raw", "raw": "{\n  \"vehicle_plate\": \"ABC-1234\",\n  \"timestamp\": \"2026-08-12T12:00:00Z\",\n  \"location\": \"Quito\",\n  \"status\": \"OK\"\n}" } } },
        { "name": "Get fleet log by id (Public) - GET /api/fleet-logs/:id/", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/fleet-logs/{{fleetLogId}}/", "host": ["{{baseUrl}}"], "path": ["api", "fleet-logs", "{{fleetLogId}}", ""] } } }
      ]
    },
    {
      "name": "Rental Events",
      "item": [
        { "name": "List rental events (Public) - GET /api/rental-events/", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/rental-events/", "host": ["{{baseUrl}}"], "path": ["api", "rental-events", ""] } } },
        { "name": "Create rental event (Public) - POST /api/rental-events/ (save rentalEventId)", "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "let jsonData = {};", "try { jsonData = pm.response.json(); } catch (e) {}", "if (jsonData._id) pm.collectionVariables.set('rentalEventId', jsonData._id);", "pm.test('Rental event creado', function () { pm.expect(jsonData._id).to.be.ok; });" ] } } ], "request": { "method": "POST", "header": [ { "key": "Content-Type", "value": "application/json" } ], "url": { "raw": "{{baseUrl}}/api/rental-events/", "host": ["{{baseUrl}}"], "path": ["api", "rental-events", ""] }, "body": { "mode": "raw", "raw": "{\n  \"rental_id\": \"{{rentalId}}\",\n  \"event_type\": \"START\",\n  \"notes\": \"Inicio del alquiler\"\n}" } } },
        { "name": "Get rental event by id (Public) - GET /api/rental-events/:id/", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/rental-events/{{rentalEventId}}/", "host": ["{{baseUrl}}"], "path": ["api", "rental-events", "{{rentalEventId}}", ""] } } }
